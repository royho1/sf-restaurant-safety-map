# Copy to frontend/.env and fill in your Mapbox public token.
# https://account.mapbox.com/access-tokens/

VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Leave unset in local dev to use the Vite proxy (/api → http://127.0.0.1:5001).
# Set this if the API is on another host or port.
# VITE_API_BASE=http://localhost:5001
